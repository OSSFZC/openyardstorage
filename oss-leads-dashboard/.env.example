# Copy to .env.local for local use. On Vercel: Project -> Settings -> Environment Variables.

# The one dashboard login (there is no sign-up page)
ADMIN_USERNAME=osslogistics
ADMIN_PASSWORD=

# Long random string; the website sends leads to /api/lead?key=<this>
WEBHOOK_KEY=

# Filled in automatically on Vercel when you connect a Neon database (Storage tab).
# Leave empty locally to use the embedded database in .data/
DATABASE_URL=

# Optional
APP_TIMEZONE=Asia/Kolkata
CLIENT_NAME=OSS FZC - Energy Logistics

# ---------- Marketing tab ----------
# Service-account JSON key, base64-encoded (macOS: base64 -i key.json | pbcopy)
GOOGLE_SA_KEY=
# Numeric GA4 property ID (GA4 Admin -> Property details), not the G- measurement ID
GA4_PROPERTY_ID=
# "sc-domain:openyardstorage.com" or "https://www.openyardstorage.com/"
GSC_SITE=
GTM_ID=GTM-WRN3ZBSZ
SITE_URL=https://www.openyardstorage.com
