# Copy this file to .env.local for local development (never commit .env.local).
# On Vercel, add the same keys under Project > Settings > Environment Variables.

# Gmail account that SENDS the contact-form email (use a Gmail App password, not the normal password)
EMAIL_USER=ossfzcenergylogistics@gmail.com
EMAIL_PASS=
# Inbox that RECEIVES the contact-form email (the client)
EMAIL_TO=

# LeadHub dashboard webhook: every form submission is also stored there.
# Local XAMPP:  http://localhost/leadhub/api/lead.php?key=WEBHOOK_KEY
# Live:         https://your-leadhub-domain/api/lead.php?key=WEBHOOK_KEY
LEADHUB_URL=
